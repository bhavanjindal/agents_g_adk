GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# data_engineering_agent model switch — see data_engineering_agent/README.md
# AGENT_MODEL_PROVIDER=gemini            # default; uses GEMINI_MODEL below
# GEMINI_MODEL=gemini-flash-latest

# AGENT_MODEL_PROVIDER=anthropic         # routes every agent through Claude
# ANTHROPIC_MODEL=claude-sonnet-5        # or claude-opus-4-8 (harder reasoning), claude-haiku-4-5 (cheap/fast)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AGENT_MODEL_PROVIDER=ollama            # routes every agent through a local Ollama model
# OLLAMA_MODEL=qwen3.6:latest            # must support TOOL CALLING (llama3/mistral/llama2 do not) — verify with:
                                          #   curl -s http://localhost:11434/api/show -d '{"name":"MODEL_NAME"}' | grep tools
# OLLAMA_API_BASE=http://localhost:11434

# trade_agent — see trade_agent/README.md. Gemini-only (no provider switch —
# a real-money agent stays on one well-understood provider). Kite MCP itself
# needs no key here: `npx mcp-remote https://mcp.kite.trade/mcp` handles Kite
# OAuth login interactively the first time it connects.
# GEMINI_MODEL=gemini-flash-latest       # used by most trade_agent sub-agents
# GEMINI_PRO_MODEL=gemini-pro-latest     # used only by StrategyDecisionAgent

# News/sentiment source (a dedicated API — e.g. https://newsapi.org, free tier
# available). Without a key, news_sentiment_analyst degrades gracefully and
# the agent falls back to technicals-only signals.
NEWS_API_KEY=your_news_api_key_here
NEWS_API_BASE_URL=https://newsapi.org/v2

# trade_agent risk limits — hard-coded safety rails checked by RiskGate before
# any order can reach human approval. All amounts in INR.
MAX_CAPITAL_PER_TRADE_INR=10000
MAX_DAILY_LOSS_INR=2000
MAX_OPEN_POSITIONS=5
MIN_DAYS_TO_EXPIRY=2
