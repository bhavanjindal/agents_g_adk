GOOGLE_API_KEY=your_google_api_key_here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# data_engineering_agent model switch — see data_engineering_agent/README.md
# AGENT_MODEL_PROVIDER=gemini            # default; uses GEMINI_MODEL below
# GEMINI_MODEL=gemini-flash-latest

# AGENT_MODEL_PROVIDER=anthropic         # routes every agent through Claude
# ANTHROPIC_MODEL=claude-sonnet-5        # or claude-opus-4-8 (harder reasoning), claude-haiku-4-5 (cheap/fast)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# AGENT_MODEL_PROVIDER=ollama            # routes every agent through a local Ollama model
# OLLAMA_MODEL=qwen2.5:14b               # must support TOOL CALLING (llama3/mistral/llama2 do not) — verify with:
                                          #   curl -s http://localhost:11434/api/show -d '{"name":"MODEL_NAME"}' | grep tools
# OLLAMA_API_BASE=http://localhost:11434
